{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Solar product item in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "images": { "type": "array" },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "warranty": { "type": "string" },
        "specs": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "categoryId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "productCount": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Promotional carousel slide on homepage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heading": { "type": "string" },
        "description": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "heading", "description"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed via WhatsApp checkout",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reference": { "type": "string" },
        "userId": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentVerified": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reference", "total", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Customer feedback and review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "review": { "type": "string" },
        "solarInstalled": { "type": "string" },
        "isApproved": { "type": "boolean" }
      },
      "required": ["id", "name", "review", "rating"]
    },
    "WebsiteSettings": {
      "title": "WebsiteSettings",
      "description": "Global website configuration and business settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "tagline": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "displayWhatsapp": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" }
      },
      "required": ["companyName", "whatsappNumber"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Solar energy products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Solar categories"
    },
    "/hero_slides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Homepage hero carousel slides"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "WhatsApp checkout customer orders"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Customer reviews and testimonials"
    },
    "/settings/general": {
      "schema": "WebsiteSettings",
      "description": "Global website configuration"
    }
  }
}
